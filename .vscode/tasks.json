{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Quartz Install Plugins",
            "type": "shell",
            "command": "npx",
            "args": [
                "quartz",
                "plugin",
                "install",
                "--from-config"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "detail": "Install plugins referenced in quartz.config.yaml that are not installed yet (links local plugins into .quartz/plugins)"
        },
        {
            "label": "Build Local Plugins",
            "dependsOn": "Quartz Install Plugins",
            "type": "shell",
            "command": "npm",
            "args": [
                "run",
                "build",
                "--prefix",
                "plugins/slim-properties"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "detail": "Rebuild dist/ of local plugins - Quartz uses a pre-built dist/ as-is and never rebuilds it from src/"
        },
        {
            "label": "Quartz Build to Debian Apache2",
            "dependsOn": "Build Local Plugins",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "npx quartz build --directory Siebenlande --output /var/www/html && cp .htaccess /var/www/html/.htaccess"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "detail": "Build Quartz site and output to Debian Apache2 directory (/var/www/html)"
        },
        {
            "label": "Quartz Build and Serve Local",
            "dependsOn": "Build Local Plugins",
            "type": "shell",
            "command": "npx",
            "args": [
                "quartz",
                "build",
                "--directory",
                "Siebenlande",
                "--serve"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "isBackground": true,
            "detail": "Build and serve Quartz site locally for development"
        },
        {
            "label": "Quartz Build Local",
            "dependsOn": "Build Local Plugins",
            "type": "shell",
            "command": "npx",
            "args": [
                "quartz",
                "build",
                "--directory",
                "Siebenlande"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "detail": "Build Quartz site locally without serving"
        },
        {
            "label": "Quartz Serve Local",
            "type": "shell",
            "command": "npx",
            "args": [
                "serve",
                "public"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "isBackground": true,
            "detail": "Serve the built Quartz site locally - no rebuilt, no file watching"
        }
    ]
}